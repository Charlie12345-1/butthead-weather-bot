{"type":"FeatureCollection","features":[{"id":"1211557031433598417202609280502_fea1-2320","type":"Feature","geometry":null,"properties":{"alert_name_en":"rainfall warning","alert_text_en":"Heavy rain is expected.\n\nWhere: \nCentral Coast - coastal sections.\n\nWhen:\nNow until late this afternoon.\n\nRemarks:\nA robust frontal system is bringing heavy rainfall at times to the region. Rainfall amounts of 100 mm are expected. The frontal system is also bringing strong and gusty southerly winds today, mainly over exposed areas near the water.\n\nThe heavy rain will ease later this afternoon.\n\nWater will likely pool on roads and in low-lying areas. Local utility outages are possible.\n\nDon't drive through flooded roadways. Allow extra time for travel.\n\nPlease continue to monitor alerts and forecasts issued by Environment Canada. To report severe weather, send an email to BCstorm@ec.gc.ca or post reports on social media using #BCStorm.","alert_type":"warning","feature_name_en":"Central Coast - coastal sections","feature_id":"fea1-2320","status_en":"issued","expiration_datetime":"2026-09-29T03:30:48.692Z","publication_datetime":"2026-09-28T12:31:48.692Z","risk_colour_en":"yellow","impact_en":"Moderate","confidence_en":"High"}}],"numberMatched":1,"numberReturned":1,"links":[{"type":"application/geo+json","rel":"self","title":"This document as GeoJSON","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=json&limit=8&skipGeometry=true&properties=alert_name_en,alert_text_en,alert_type,feature_name_en,feature_id,status_en,expiration_datetime,publication_datetime,risk_colour_en,impact_en,confidence_en&feature_name_en=Central%20Coast%20-%20coastal%20sections"},{"rel":"alternate","type":"application/ld+json","title":"This document as RDF (JSON-LD)","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=jsonld&limit=8&skipGeometry=true&properties=alert_name_en,alert_text_en,alert_type,feature_name_en,feature_id,status_en,expiration_datetime,pub